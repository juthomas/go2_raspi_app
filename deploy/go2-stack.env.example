# Copy to /etc/default/go2-stack and adjust paths if needed.
# Used by deploy/systemd/go2-stack.service

# Network
IFACE=eth0
ROBOT_IP=192.168.123.161

# Project paths (defaults match this repo layout)
GO2_APP_ROOT=/home/pigeons/Documents/unitree/go2_raspi_app
CYCLONEDDS_HOME=/home/pigeons/cyclonedds-prefix

# go2_prepare_robot.py
PREPARE_RETRIES=30
PREPARE_INTERVAL=2
ROBOT_WARMUP_S=5
MAPPING_CMDS=START,ON,start_mapping
PREPARE_PROBE_DURATION=5

# WebSocket ports
LIDAR_WS_PORT=8765
CONTROL_WS_PORT=8766

# go2_video_webrtc_bridge.py (set VIDEO_ENABLED=0 to disable)
VIDEO_ENABLED=1
VIDEO_HTTP_PORT=8081
VIDEO_FPS=15

# go2_control_ws_bridge.py (optional overrides)
CONTROL_POSTURE_GUARD_S=1.4
CONTROL_PRE_POSTURE_DELAY_S=0.12
# Disable protocol-level WS ping (0); app sends {type:"ping"} every 2s. Avoids 1011 on slow WiFi.
CONTROL_WS_PING_INTERVAL=0

# go2_lidar_ws_bridge.py flags (set to 0 to disable)
LIDAR_VOXEL=1
# height_map (default, Unitree app mapping), compressed, or both
LIDAR_VOXEL_MAP_SOURCE=height_map
# Only used when LIDAR_VOXEL_MAP_SOURCE is compressed or both (LZ4 voxel_map_compressed)
LIDAR_VOXEL_DECOMPRESS=0
LIDAR_INCLUDE_JOINTS=1
