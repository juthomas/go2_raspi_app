[Unit]
Description=GO2 LiDAR + control + video WebRTC stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=billy
WorkingDirectory=/home/billy/Documents/unitree/go2_raspi_app
EnvironmentFile=-/etc/default/go2-stack
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/billy/Documents/unitree/go2_raspi_app/scripts/go2_stack_startup.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
